{
  "name": "pi-ghidra",
  "version": "0.3.0",
  "description": "Autonomous headless Ghidra 12 reverse engineering for Pi, omp, and MCP clients: decompile, xrefs, call graphs, strings, memory, and patches without the GUI.",
  "type": "module",
  "license": "MIT",
  "author": "immutex",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/immutex/pi-ghidra.git"
  },
  "homepage": "https://github.com/immutex/pi-ghidra#readme",
  "bugs": {
    "url": "https://github.com/immutex/pi-ghidra/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pi-package",
    "pi",
    "omp",
    "oh-my-pi",
    "mcp",
    "mcp-server",
    "ghidra",
    "ghidra-headless",
    "reverse-engineering",
    "binary-analysis",
    "decompiler",
    "disassembler",
    "malware-analysis",
    "firmware",
    "headless",
    "ai-agent",
    "coding-agent"
  ],
  "files": [
    "extensions",
    "src",
    "mcp",
    "ghidra_scripts",
    "skills",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "omp": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "tsx --test test/runtime.test.ts test/extension.test.ts test/mcp.test.ts",
    "test:integration": "tsx --test test/integration.test.ts",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm run check && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "latest",
    "@types/node": "latest",
    "tsx": "latest",
    "typebox": "latest",
    "typescript": "latest"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
