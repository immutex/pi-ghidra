{
  "name": "pi-ghidra",
  "version": "0.2.0",
  "description": "Autonomous headless Ghidra analysis tools for Pi",
  "type": "module",
  "license": "MIT",
  "author": "immutex",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/immutex/pi-ghidra.git"
  },
  "homepage": "https://github.com/immutex/pi-ghidra#readme",
  "bugs": {
    "url": "https://github.com/immutex/pi-ghidra/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pi-package",
    "ghidra",
    "reverse-engineering",
    "decompiler",
    "headless"
  ],
  "files": [
    "extensions",
    "src",
    "ghidra_scripts",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "tsx --test test/runtime.test.ts test/extension.test.ts",
    "test:integration": "tsx --test test/integration.test.ts",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm run check && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "latest",
    "@earendil-works/pi-coding-agent": "latest",
    "@types/node": "latest",
    "tsx": "latest",
    "typebox": "latest",
    "typescript": "latest"
  },
  "engines": {
    "node": ">=20"
  }
}
